# Base de datos
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
# Aiven y otros proveedores gestionados exigen TLS.
DB_SSL=true
# Con `true`, la app aplica las migraciones al arrancar. En produccion conviene
# `false` y ejecutarlas aparte (`npm run migration:run`), para que varias
# instancias no compitan al desplegar.
DB_RUN_MIGRATIONS=false

PORT=3000
NODE_ENV=development

# --- Autenticacion ----------------------------------------------------------
# Secretos distintos para access y refresh. Si uno se filtra, el otro sigue
# sirviendo para su proposito. Minimo 32 caracteres.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Caducidad del access token. Formato: 900 (segundos), 15m, 1h, 7d.
# Corto a proposito: es el token que viaja en cada peticion.
JWT_ACCESS_EXPIRES_IN=15m
# Caducidad del refresh token. Solo se usa como valor informativo: la fecha que
# manda es `refresh_token.expira_en`, escrita en el momento de emitirlo.
JWT_REFRESH_EXPIRES_IN=7d

# --- Limites de peticiones ----------------------------------------------------
# Numero maximo de peticiones por IP y por ventana de 60 segundos. Los tres
# valores cuentan por separado: los limites especificos se consumen ademas del
# global, no lo sustituyen.
# Tope general de la API.
THROTTLE_GLOBAL=120
# Intentos de login por IP. Volcado a proposito: es lo que frena la fuerza bruta
# contra el par usuario/contrasena.
THROTTLE_LOGIN=5
# Renovaciones de sesion por IP, para que un refresh no se convierta en un metodo
# para alargar la sesion indefinidamente.
THROTTLE_REFRESH=30

# --- Datos sensibles --------------------------------------------------------
# Pepper para el HMAC-SHA256 con el que se guardan los refresh tokens. Minimo 32.
# Rotarlo invalida todas las sesiones abiertas.
DATA_HASH_KEY=
# Clave AES-256-GCM con la que se cifran documento de identidad, IBAN y salario. Minimo 32.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# OBLIGATORIA y distinta de DATA_HASH_KEY. Sin ella la aplicacion no arranca.
# Advertencia: los datos se guardan cifrados, no como texto plano, y el indice con el que
# se buscan es un HMAC de esta misma clave. Asi que rotarla deja ilegibles los documentos,
# IBAN y salarios ya cifrados, y sus indices dejan de coincidir con los nuevos: no hay
# forma de recuperarlos. Antes de cambiarla en un entorno con datos, hay que descifrar con
# la clave antigua, cifrar con la nueva y regenerar los indices.
DATA_ENCRYPTION_KEY=

# --- Retencion -----------------------------------------------------------------
# Dias que se conservan las filas que `npm run mantener` puede borrar. Los valores
# estan aqui, y no en el codigo, porque el plazo que sirve para una base de
# desarrollo no es el que sirve para una que tiene que responder por sus cambios
# dentro de tres anos.
#
# Refresh tokens ya caducados. Un token caducado no vale para nada, asi que el
# plazo es corto.
RETENCION_TOKENS_DIAS=30
# Registros de auditoria. Es historico: quien cambio un salario y cuando puede ser
# una pregunta que aparezca mucho despues, asi que el plazo es largo.
RETENCION_AUDITORIA_DIAS=365